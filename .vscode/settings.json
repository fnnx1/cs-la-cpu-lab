{
  // ===================== 语言服务器：verible-verilog-ls =====================
  // 提供跨文件跳转定义 / 悬停 / 补全 / 符号查找（.v 与 .sv 都生效）。
  // 注意：verible-verilog-ls 的诊断与格式化能力被本扩展屏蔽（避免与下面的
  // linter/formatter 重复），它只负责“导航”类功能。
  "verilog.languageServer.veribleVerilogLs.enabled": true,
  "verilog.languageServer.veribleVerilogLs.path": "/usr/bin/verible-verilog-ls",
  "verilog.languageServer.veribleVerilogLs.arguments": "",

  // 其余语言服务器保持关闭，避免重复的诊断/补全结果。
  // 本项目是纯 Verilog（.v），而 svls / veridian 只对 SystemVerilog（.sv）生效。
  "verilog.languageServer.svls.enabled": false,
  "verilog.languageServer.veridian.enabled": false,
  "verilog.languageServer.hdlChecker.enabled": false,

  // ===================== 语法检查：Icarus Verilog =====================
  // 打开/保存文件时自动运行；也可在命令面板执行 “Verilog: Rerun lint tool”。
  "verilog.linting.linter": "iverilog",
  "verilog.linting.iverilog.verilogHDL.standard": "Verilog-2005",
  "verilog.linting.iverilog.runAtFileLocation": false,
  "verilog.linting.iverilog.includePath": [
    // 两个 CPU 工程各自的 RTL 入口目录。
    "cdp_ede_local-master/mycpu_env/myCPU",
    "USTB_loongarch32e-pipeline-CPU/rtl",
    // 公共 alu/regfile/tools 源码目录。
    "cdp_ede_local-master/mycpu_env/myCPU/common",
    "USTB_loongarch32e-pipeline-CPU/rtl/common",
    // cpu_cde.h / test_define.h 等头文件所在目录
    "cdp_ede_local-master/mycpu_env/func/include"
  ],
  // 单文件 lint 时 iverilog 只编译当前文件，-y 让它按“模块名 = 文件名”
  // 搜索两个工程的 RTL/common 目录。两个工程当前共用同一份
  // mycpu_defines.vh 和 common 模块，因此只需要显式加入一次 tools.v。
  // lint_stubs.v 只补厂商生成的 div_signed/div_unsigned 黑盒，不参与综合。
  // 编辑 tools.v 本身时，最后两个文件会造成重复定义，可临时删掉它们。
  // -Wall：打开 iverilog 的全部警告。其中对本项目最关键的是
  //   -Wimplicit —— 隐式声明 wire/reg：`assign xx = ...` 写到没声明的名字时
  //   xx 会变成 1 位的隐式 wire（例如漏了位宽声明的拼接
  //   `assign to_ds_to_es_bus = {...}`），本项目踩过这个坑，就靠它报出来。
  //   另外还含 -Wportbind（实例化时输入端口悬空）、-Wtimescale、-Wtristate 等。
  // 注意：iverilog 不做位宽检查，所以“声明了但位宽写错/漏写”这类
  //   （如 `wire to_es_to_ms_bus = {...}` —— 声明成 1 位了）它报不出来，
  //   那类要靠 verilator，配置见文件末尾（装好后可切换 linter）。
  "verilog.linting.iverilog.arguments": "-Wall -y cdp_ede_local-master/mycpu_env/myCPU -y cdp_ede_local-master/mycpu_env/myCPU/common -y USTB_loongarch32e-pipeline-CPU/rtl -y USTB_loongarch32e-pipeline-CPU/rtl/common cdp_ede_local-master/mycpu_env/myCPU/common/tools.v .vscode/iverilog_lint_stubs.v",

  // ===================== 格式化：verible-verilog-format =====================
  // 选中代码后 Shift+Alt+F 即可；注意不支持“仅格式化选中范围”。
  "verilog.formatting.verilogHDL.formatter": "verible-verilog-format",
  "verilog.formatting.systemVerilog.formatter": "verible-verilog-format",
  "verilog.formatting.veribleVerilogFormatter.path": "/usr/bin/verible-verilog-format",

  // ============ 位宽等深度检查：Verilator（需先安装，装好后可切换）============
  // iverilog 不做的检查，verilator 的 -Wall 会做：
  //   WIDTH（位宽不匹配/截断）、UNDRIVEN、UNUSEDSIGNAL、PINMISSING（端口没接）、
  //   UNOPTFLAT（组合环，例如 alu.v 里 or_result 回接 alu_result）、LATCH 等。
  // 安装（需要你自己在终端执行，要 sudo）：
  //   sudo pacman -S verilator
  // 装好后把上面的 "verilog.linting.linter" 从 "iverilog" 改成 "verilator"
  // （扩展一次只能跑一个 linter），用完可再切回 iverilog。
  // 扩展会自动在前面补 --lint-only -I<当前文件所在目录>，这里只写额外参数：
  //   -y <dir> +libext+.v  单文件 lint 时按“模块名 = 文件名”补找其他模块
  //   -Wno-DECLFILENAME    tools.v 里文件名与模块名不一致，否则会刷屏
  //   -Wno-fatal           警告不要变成 error（否则退出码非 0）
  // 若某些警告太吵，可自行追加 -Wno-XXX（如 -Wno-UNUSED）。
  "verilog.linting.verilator.arguments": "-Wall -Wno-DECLFILENAME -Wno-fatal -y cdp_ede_local-master/mycpu_env/myCPU -y cdp_ede_local-master/mycpu_env/myCPU/common -y USTB_loongarch32e-pipeline-CPU/rtl -y USTB_loongarch32e-pipeline-CPU/rtl/common +libext+.v",
  "verilog.linting.verilator.includePath": [
    "cdp_ede_local-master/mycpu_env/myCPU",
    "cdp_ede_local-master/mycpu_env/myCPU/common",
    "USTB_loongarch32e-pipeline-CPU/rtl",
    "USTB_loongarch32e-pipeline-CPU/rtl/common"
  ]
}
